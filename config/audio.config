# ==========================================
# Audio Processor Configuration
# ==========================================

# Supported audio format
audio_format = PCM
bits_per_sample = 16
channels = 1
sample_rate = 44100

# FFT & windowing
fft_window_size = 2048
overlap_ratio = 0.50

# 5-band LED mapping & sensitivity
band_edges_hz = 20.0, 60.0, 250.0, 2000.0, 4000.0, 20000.0
band_rms_ceiling = 0.25

# Beat onset & BPM estimation
min_beat_interval_sec = 0.28
onset_flux_threshold = 0.035
max_onset_history = 32
default_bpm = 120.0
