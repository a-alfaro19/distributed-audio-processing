# ==========================================
# Root Makefile for Distributed Audio Processing
# ==========================================

# Directories
BIN_DIR = bin
BUILD_DIR = build
SERVER_DIR = src/server

.PHONY: all clean server server-run

# Default target: compile everything essential
all: server

# Build the server binary
server:
		@mkdir -p $(BIN_DIR)
		@mkdir -p $(BUILD_DIR)/server
		$(MAKE) -C $(SERVER_DIR)

# Run the server/cluster component specifically
run-server: server
	$(MAKE) -C $(SERVER_DIR) run

# Clean all generated binaries and objects across modules
clean:
		@echo "Cleaning binaries and objects..."
		rm -rf $(BIN_DIR)/* $(BUILD_DIR)/*

# Clean only binaries and objects generated by server
clean-server:
		@echo "Cleaning server's binaries and objects..."
		$(MAKE) clean -C $(SERVER_DIR)
